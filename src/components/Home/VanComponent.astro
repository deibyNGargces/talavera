---
//import coche from "@/assets/images/home/Coche.png";
import coche from "@/assets/images/home/homeCoche.png";
import MountainBG from "@components/Utilities/MountainBG.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { CONTACT_PHONE } from "../../api/api";
---

<div class="bg-[#599DDF]  relative overflow-hidden min-h-[90vh] lg:min-h-[60vh] ">
  <div
      class="absolute h-full   w-full flex items-center justify-end "
    >
      <Image src={coche} alt="Coche" class="h-full w-full  object-cover" />
    </div>
  <div class="grid grid-cols-1  md:grid-cols-2 w-full h-full relative  ">
    <div
      class=" mt-8 md:mt-16 min-h-[60vh] lg:min-h-[70vh] left-fadeIn order-2 md:order-1 text-center md:text-left text-white flex-1 flex flex-col justify-center items-center md:items-start px-4 lg:px-24 "
    >
      <h2 class="text-center md:text-left text-3xl font-bold">
        ¿Necesitas un lugar seguro para tu coche?
      </h2>
      <p class="text-2xl my-5">
        Contamos con plazas de garaje disponibles en Avenida Isaac Newton 7,
        Getafe – Madrid CP 28906
      </p>
      <a
        href={`https://wa.me/${CONTACT_PHONE}/?text=Hola%20quiero%20m%C3%A1s%20informaci%C3%B3n%20sobre%20la%20plaza%20de%20garaje`}
        class="bg-sky-600 max-w-max flex py-2 px-8 rounded-full font-bold mt-4"
      >
        <Icon name="WhatsApp" class="w-6 h-6" />
        Alquila tu plaza ahora</a
      >
    </div>
  </div>
  <div class="absolute bottom-0 w-full">

    <div class=" relative">
      <MountainBG />
    </div>
  </div>
</div>
