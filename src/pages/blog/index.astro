---
import Layout from "../../layouts/Layout.astro";
import BlogPreview from "@components/Blog/BlogPreview.astro";
import Image from "astro/components/Image.astro";
import banner from "../../../public/images/bannerblog.png"

// TODO:consulta todos los post y los ordena por fecha
let allPost = await Astro.glob("../posts/**/*.md");
allPost = allPost.sort(
  (a, b) =>
    new Date(b.frontmatter.date).valueOf() -
    new Date(a.frontmatter.date).valueOf()
);
---

<Layout title="Yeguada Selecta">
  <main class="pt-32 max-w-screen-xl mx-auto min-h-screen">
    <!-- <Title
      title="Blog"
      title2="de la Yeguada Selecta"
      subtitle="Noticias y novedades"
    /> -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4">
      <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          allPost.map((post) => (
            <BlogPreview post={post.frontmatter} url={post.url} />
          ))
        }
      </div>
      <div class="md:col-span-1 ">
      <div class=" h-screen relative rounded-3xl overflow-hidden">
        <div class="absolute z-10  px-8 top-0 left-0 w-full h-full flex flex-col  items-center text-center gap-6 pt-16">
          <p class="text-4xl w-full font-semibold  ">DISFRUTA  DE NUESTROS PRODUCTOS</p>
          <a href="/products/quesos" class="text-white bg-blue-900 py-2 px-8 rounded-xl  ">Ver productos</a>
        </div>
        <Image src={banner} alt="Wave" class="w-full object-cover absolute bottom-0" />
      </div>
      </div>
    </div>
  </main>
</Layout>
