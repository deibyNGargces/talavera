---
import WspButton from "@components/Utilities/WspButton.astro";
import Footer from "../components/Footer.astro";
import HeaderNavigator from "../components/HeaderNavigator.astro";
import Title from "@components/Blog/Title.astro";
import HeroPost from "@components/Blog/HeroPost.astro";
const { title } = Astro.props;
const { frontmatter } = Astro.props;
---

<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <HeaderNavigator />
    <HeroPost
      title={frontmatter.title}
      title2={frontmatter.title2}
      image={frontmatter.image}
    />
    <div class="pt-12 max-w-screen-xl mx-auto">
      <Title
        id="post"
        title={frontmatter.title}
        title2={frontmatter.title2}
        subtitle={frontmatter.category}
        date={frontmatter.date}
      />
      <div class="px-4 mb-8 ">
        <!-- div para el contenido seteado para que no tome los estilos de tailwind sino los stilos de  -->
        <div class="[&>p>strong]:text-blue-500 [&>p>strong]:font-bold
        [&>h1]:text-4xl [&>h1]:font-bold [&>h1]:mb-2 [&>h1]:mt-4
        [&>h2]:text-3xl [&>h2]:font-bold [&>h2]:mb-2 [&>h2]:mt-4
        [&>h3]:text-2xl [&>h3]:font-bold [&>h3]:mb-2 [&>h3]:mt-4
        [&>h4]:text-xl [&>h4]:font-bold [&>h4]:mb-2 [&>h4]:mt-4
        [&>h5]:text-lg [&>h5]:font-bold [&>h5]:mb-2 [&>h5]:mt-4
        [&>h6]:text-base [&>h6]:font-bold [&>h6]:mb-2 [&>h6]:mt-4 
        [&>ul]:list-disc [&>ul]:pl-4
        [&>ol]:list-decimal [&>ol]:pl-4
        [&>ul>li]:mb-2 [&>ol>li]:mb-2
        [&>ul>li]:list-disc [&>ol>li]:list-decimal
        [&>ul>li]:pl-4 [&>ol>li]:pl-4
        [&>img]:w-full [&>img]:h-auto [&>img]:object-cover [&>img]:rounded-lg [&>img]:mt-4 [&>img]:mb-4
        ">  
            <slot />
        </div>
      </div>
    </div>
    <Footer />
    <WspButton />
  </body>
</html>

<style is:global>
  :root {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .autoShow {
    animation: autoShowAnimation;
    animation-timeline: view(80% auto);
    -webkit-animation-timeline: view(80% auto);
  }
  @keyframes autoShowAnimation {
    from {
      opacity: 0;
      transform: translateY(20%) scale(0.3);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .right-fadeIn {
    animation: rightFadeIn 1s ease-in-out;
    animation-timeline: view(70% auto);
    -webkit-animation-timeline: view(70% auto);
  }

  @keyframes rightFadeIn {
    from {
      opacity: 0;
      transform: translateX(20%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .left-fadeIn {
    animation: leftFadeIn 1s ease-in-out;
    animation-timeline: view(70% auto);
    -webkit-animation-timeline: view(70% auto);
  }

  /* add mozilla webkit  */
  @keyframes leftFadeIn {
    from {
      opacity: 0;
      transform: translateX(-20%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
