---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import bgWave from "../../assets/images/home/carrusel/curve.png";

// Definir las imágenes y datos del carrusel de forma estática
const slides = [
  {
    url: "/images/home/carrusel/slide1.webp",
    urlMin: "/images/home/carrusel/minslide1.webp",
    nombre: "Arepas",
    descripcion: "Arepas de maíz pelado rellenas de carne mechada, pollo, pernil, queso, chicharrón, entre otros.",
  },
  {
    url: "/images/home/carrusel/slide2.webp",
    urlMin: "/images/home/carrusel/minslide2.webp",
    nombre: "Quesos",
    descripcion: "Quesos frescos, semiduros, duros, madurados, ahumados, entre otros.",
  },
  {
    url: "/images/home/carrusel/slide3.webp",
    urlMin: "/images/home/carrusel/minslide3.webp",
    nombre: "Carnicos",
    descripcion: "Carnes de res, cerdo, pollo, pescado, embutidos, entre otros.",
  },
  {
    url: "/images/home/carrusel/slide4.webp",
    urlMin: "/images/home/carrusel/minslide4.webp",
    nombre: "Dulces",
    descripcion: "Dulces típicos, tortas, galletas, panes, entre otros.",
  },
];
---

<div class="h-screen w-full relative">
  <div class="w-full h-screen carousel">
    <!-- Botones de navegación -->
    <div class="navigation-buttons absolute z-50 w-full h-full flex justify-between items-center px-5 md:px-20">
      <button
        aria-label="Anterior imagen"
        class="carousel-button prev-button flex items-center justify-center bg-white/80 hover:bg-white rounded-full h-10 w-10 shadow-md transition-colors"
      >
        <Icon name="LeftArrow" class="w-6 h-6" />
      </button>
      
      <button
        aria-label="Siguiente imagen"
        class="carousel-button next-button flex items-center justify-center bg-white/80 hover:bg-white rounded-full h-10 w-10 shadow-md transition-colors"
      >
        <Icon name="RightArrow" class="w-6 h-6" />
      </button>
    </div>

    <!-- Contenedor de imágenes -->
    <div class="carousel-container relative w-full h-full">
      {slides.map((slide, index) => (
        <div class={`carousel-slide absolute w-full h-full transition-opacity duration-500 ${index === 0 ? 'opacity-100' : 'opacity-0'}`} data-index={index}>
          <Image
            src={slide.url}
            alt={slide.nombre}
            width={1920}
            height={1080}
            class="w-full h-full object-cover hidden lg:block"
            loading={index === 0 ? "eager" : "lazy"}
          />
          <Image
            src={slide.urlMin}
            alt={slide.nombre}
            width={768}
            height={1024}
            class="w-full h-full object-cover lg:hidden"
            loading={index === 0 ? "eager" : "lazy"}
          />
        </div>
      ))}
    </div>
  </div>

  <div class="absolute w-full bottom-0">
    <Image src={bgWave} alt="Wave" class="w-full object-cover -mb-1" />
  </div>
</div>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap");
  .carousel {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .carousel-slide {
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .carousel-slide.active {
    opacity: 1;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  class Carousel {
    private currentIndex: number;
    private slides: NodeListOf<Element>;
    private prevButton: HTMLButtonElement | null;
    private nextButton: HTMLButtonElement | null;
    private autoPlayInterval: number;
    private autoPlayTimer: number | null;

    constructor() {
      this.currentIndex = 0;
      this.slides = document.querySelectorAll('.carousel-slide');
      this.prevButton = document.querySelector('.prev-button');
      this.nextButton = document.querySelector('.next-button');
      this.autoPlayInterval = 4000;
      this.autoPlayTimer = null;

      this.init();
    }

    private init(): void {
      // Mostrar la primera imagen inmediatamente
      this.showSlide(0);
      
      this.preloadImages();
      
      this.prevButton?.addEventListener('click', () => this.prevSlide());
      this.nextButton?.addEventListener('click', () => this.nextSlide());
      
      this.startAutoPlay();

      const carousel = document.querySelector('.carousel');
      carousel?.addEventListener('mouseenter', () => this.stopAutoPlay());
      carousel?.addEventListener('mouseleave', () => this.startAutoPlay());
    }

    private preloadImages(): void {
      const images = Array.from(document.querySelectorAll<HTMLImageElement>('.carousel-slide img'));
      images.forEach(img => {
        const image = new Image();
        image.src = img.src;
      });
    }

    private showSlide(index: number): void {
      this.slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('active');
          slide.classList.remove('opacity-0');
          slide.classList.add('opacity-100');
        } else {
          slide.classList.remove('active');
          slide.classList.add('opacity-0');
          slide.classList.remove('opacity-100');
        }
      });
    }

    private nextSlide(): void {
      this.currentIndex = (this.currentIndex + 1) % this.slides.length;
      this.showSlide(this.currentIndex);
    }

    private prevSlide(): void {
      this.currentIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
      this.showSlide(this.currentIndex);
    }

    private startAutoPlay(): void {
      if (this.autoPlayTimer === null) {
        this.autoPlayTimer = window.setInterval(() => this.nextSlide(), this.autoPlayInterval);
      }
    }

    private stopAutoPlay(): void {
      if (this.autoPlayTimer !== null) {
        window.clearInterval(this.autoPlayTimer);
        this.autoPlayTimer = null;
      }
    }
  }

  // Asegurarnos de que el carrusel se inicialice tan pronto como sea posible
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new Carousel());
  } else {
    new Carousel();
  }
</script>
