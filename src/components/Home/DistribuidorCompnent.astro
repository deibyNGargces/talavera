---
import WaveTop from "../Utilities/WaveTop.astro";
import menImage from "../../assets/images/home/men.webp";
import { Image } from "astro:assets";

---

<section class="bg-blue-950 hero-distribuidor relative md:h-[75vh] lg:h-screen ">
  
    <WaveTop />

  <div
    class="grid grid-cols-1 md:grid-cols-2 h-screen items-center max-w-screen-xl mx-auto justify-center"
  >
    <div class="container mx-auto mt-40">
      <div class="w-full text-white relative p-4 left-fadeIn mb-10">
        <h2 class="text-left text-4xl lg:text-6xl font-bold">
          Únete a <span class="font-normal block"> nuestra familia</span>
          de distribuidores
        </h2>
        <p class="text-2xl mt-4">
          Amplía tu catálogo con nuestros sabores únicos. Forma parte de nuestra
          red de distribuidores y brinda a tus clientes la experiencia de
          nuestra cocina en cada producto.
        </p>
        <a
          href="/distributors"
          class="bg-[#599DDF] text- py-1 px-8 rounded-full font-bold mt-4 inline-block"
          >Más información</a
        >
      </div>
    </div>

  </div>
  <div
    class="h-[40vh] md:h-[70vh] lg:h-[80vh] absolute bottom-0 right-0 lg:right-40 z-10"
  >
    <Image
      src={menImage}
      alt="Distribuidor"
      class="hidden md:block h-full w-auto object-cover"
    />
  </div>
</section>

<style>
  .hero-distribuidor {
    background-image: url("../../assets/images/distribuidor/heroDistribuidor.webp");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
  @media (max-width: 768px) {
    .hero-distribuidor {
      background-size: cover;
    }
  }
</style>

