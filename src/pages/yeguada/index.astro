---
import YeguadaHero from "@components/Yeguada/YeguadaHero.astro";
import Layout from "../../layouts/Layout.astro";
import AwardsSection from "@components/Yeguada/AwardsSection.astro";
import YeguadaServices from "@components/Yeguada/YeguadaServices.astro";
import YeguadaContact from "@components/Yeguada/YeguadaContact.astro";
import MountainBG from "@components/Utilities/MountainBG.astro";
import Image from "astro/components/Image.astro";

import caballos1 from "../../assets/images/Yeguada/Multimedia/Caballos1.jpg";
import caballos2 from "@/assets/images/Yeguada/Multimedia/Caballos2.png";
import caballos3 from "@/assets/images/Yeguada/Multimedia/Caballos3.jpg";
import caballos4 from "@/assets/images/Yeguada/Multimedia/Caballos4.jpg";
import caballos6 from "@/assets/images/Yeguada/Multimedia/Caballos6.png";
import caballos8 from "@/assets/images/Yeguada/Multimedia/Caballos8.png";
import caballos7 from "@/assets/images/Yeguada/Multimedia/Caballos7.png";
import yeguada from "@/assets/images/Yeguada/Multimedia/Yeguada.mp4";
import thumnl from "@/assets/images/Yeguada/Multimedia/thmnl.png";


const mediaItems = [
  { type: 'image', src: caballos1, id: 0, alt: "caballos 1" } as const,
  { type: 'image', src: caballos2, id: 1, alt: "caballos 2" } as const,
  { type: 'image', src: caballos3, id: 2, alt: "caballos 3" } as const,
  { type: 'image', src: caballos4, id: 3, alt: "caballos 4" } as const,
  { type: 'video', src: yeguada, thumbnail: thumnl, id: 4, alt: "video 1" } as const,
  { type: 'image', src: caballos6, id: 5, alt: "caballos 6" } as const,
  { type: 'image', src: caballos8, id: 6, alt: "caballos 8" } as const,
  { type: 'image', src: caballos7, id: 7, alt: "caballos 7" } as const,
] as const;




---

<Layout title="Yeguada Selecta">
  <main>
    <YeguadaHero />
    <AwardsSection />
    <YeguadaServices />
    <div>
      <!-- Galeria de imagenes -->
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 p-5">
        <div class="col-span-2 md:col-span-4 px-4 mb-8 flex flex-col items-center justify-center">
          <h2 class="text-xl  font-bold uppercase tracking-widest text-gray-800">
            CONOCE NUESTRA
          </h2>
          <h1 class="text-4xl 2xl:text-7xl font-extrabold text-gray-900">
            Yeguada
          </h1>
        </div>
        {mediaItems
          .filter((item): item is (typeof mediaItems)[number] & { type: 'image' } => item.type === 'image')
          .map(({src, alt}) => (
              <Image
                src={src}
                alt={alt}
                width={800}
                height={600}
                class="w-full h-full object-cover"
              />
        ))}     
      </div>
   
    <div class="bg-stone-900">
      <!-- <YeguadaContact /> -->
    </div>
    <div class="relative h-28 md:h-24 lg:h-16 xl:h-8 z-10">
      <MountainBG />
    </div>
  </main>
</Layout>